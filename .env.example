# Local Marklyf backend secrets
# Copy this file to .env and fill in the values. Never commit .env.

GROQ_API_KEY=

# Comma-separated browser origins allowed to call the FastAPI backend.
# Local development:
APOLLO_CORS_ORIGINS=http://localhost:5173


# Optional self-hosted Presenton renderer for Studio slide decks.
# When both values are set, Marklyf uses Presenton for editable PPTX export.
MARKLYF_PRESENTON_URL=
MARKLYF_PRESENTON_API_KEY=
MARKLYF_PRESENTON_TEMPLATE=general
MARKLYF_PRESENTON_TIMEOUT_SECONDS=45
