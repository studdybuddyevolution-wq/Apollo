# Local Marklyf backend secrets
# Copy this file to .env and fill in the values. Never commit .env.

GROQ_API_KEY=
GEMINI_API_KEY=

# Gemini generation defaults. Flash-Lite models are preferred for resilience and zero-cost operation.
APOLLO_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
APOLLO_WEB_SYNTHESIS_MODEL=gemini-3.5-flash-lite
APOLLO_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
# Render can use these defaults without adding a paid provider; unset overrides to use them.

# Comma-separated browser origins allowed to call the FastAPI backend.
# Local development:
APOLLO_CORS_ORIGINS=http://localhost:5173


# Optional self-hosted Presenton renderer for Studio slide decks.
# When both values are set, Marklyf uses Presenton for editable PPTX export.
MARKLYF_PRESENTON_URL=
MARKLYF_PRESENTON_API_KEY=
MARKLYF_PRESENTON_TEMPLATE=general
MARKLYF_PRESENTON_TIMEOUT_SECONDS=45
